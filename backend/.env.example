# Firebase project ID used to verify signed ID tokens and revocation status.
FIREBASE_PROJECT_ID=
# Uses Application Default Credentials (for local development, set
# GOOGLE_APPLICATION_CREDENTIALS to a service-account file path outside the repo).
# Never commit credentials or embed service-account JSON in this file.
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=INFO
ISIE_DATABASE_PATH=./data/isie.sqlite3
# Optional import path to trusted server-side provider adapter module exporting
# `adapter` with `source_id` and `read_measurement(metric, coordinates)`.
ISIE_MEASUREMENT_PROVIDER_MODULE=

# Startup integrations (leave unset to fail closed)
GOOGLE_MAPS_API_KEY=
ISIE_HYDROLOGY_URL=
ISIE_POPULATION_URL=
ISIE_DISPATCH_WEBHOOK_URL=
ISIE_CLOUD_PROVIDER=
STRIPE_SECRET_KEY=
# Startup provider/readiness flags
OPEN_METEO_ENABLED=1
NASA_GIBS_ENABLED=1
ISIE_AUDIT_STORAGE=
ISIE_SECURITY_REVIEW_ID=
ISIE_MODEL_VALIDATION_ID=
ISIE_EMERGENCY_AUTHORIZATION_ID=
ISIE_COMPLIANCE_REVIEW_ID=
