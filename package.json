{
  "name": "isie-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=1024' next dev -p 3000",
    "build": "NODE_ENV=production next build && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public 2>/dev/null || true",
    "start": "next start",
    "lint": "tsc --noEmit",
    "prototype:test": "node --test backend/tests/prototype-workspace.test.mjs backend/tests/prototype-completeness.test.mjs",
    "prototype:verify": "node --test backend/tests/prototype-workspace.test.mjs backend/tests/prototype-completeness.test.mjs && python -m pytest -q backend/tests/test_backend.py"
  },
  "dependencies": {
    "@google/genai": "^2.26.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@types/google.maps": "^3.66.5",
    "@types/leaflet": "^1.9.22",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "framer-motion": "^12.4.7",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.0.2",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  }
}
